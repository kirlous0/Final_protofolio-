rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Profiles
    match /profiles/{profileId} {
      allow read, write: if true;
    }

    // Projects: Allow all CRUD operations for portfolio management
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Project Images & Media
    match /projectImages/{imageId} {
      allow read, write: if true;
    }

    // Skills Taxonomy
    match /skills/{skillId} {
      allow read, write: if true;
    }

    // Services Catalog
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Contact Messages & Inquiries
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Site Settings & Socials
    match /socialLinks/{linkId} {
      allow read, write: if true;
    }

    match /siteSettings/{settingId} {
      allow read, write: if true;
    }

    // Screenshot Jobs & AI Analyses
    match /screenshotJobs/{jobId} {
      allow read, write: if true;
    }

    match /aiAnalyses/{analysisId} {
      allow read, write: if true;
    }

    match /aiSuggestions/{suggestionId} {
      allow read, write: if true;
    }

    // Activity Logs
    match /activityLogs/{logId} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
